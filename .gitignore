# macOS
.DS_Store

# Local tool config — ignore everything under .claude except shared skills
.claude/*
!.claude/skills/

# Xcode build output
build/
DerivedData/

# Written by Scripts/generate-build-info.sh on every build
Generated/

# Xcode user-specific files
*.xcuserstate
xcuserdata/
*.xcuserdatad/

# Swift Package Manager
.swiftpm/
.build/
Packages/
# Package.resolved is deliberately NOT ignored. CalPeek is an app, not a
# library: the resolved file pins the exact Sparkle revision so every machine
# and CI builds the same dependency. Xcode Cloud disables automatic dependency
# resolution outright and fails the build without it.

# CocoaPods / Carthage (in case added later)
Pods/
Carthage/Build/

# App Store capture assets (large binaries, regenerated on demand)
AppStoreAssets/
